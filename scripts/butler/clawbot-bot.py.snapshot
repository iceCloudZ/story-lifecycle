# ─── 保策（43 baoxian-server /internal/bot，S72）───
BAOXIAN_API = "https://icebao.top/internal/bot"
BAOXIAN_TOKEN = "1cab525ee2ac9ced11e45caa9bf2ffe37ca7f401c621dcda"


def baoxian_call(method, path, json_body=None, params=None):
    import urllib.request
    from urllib.parse import urlencode as _ue
    url = BAOXIAN_API + path
    if params:
        url += "?" + _ue(params)
    data = json.dumps(json_body).encode("utf-8") if json_body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("X-Internal-Token", BAOXIAN_TOKEN)
    if data:
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=30) as r:
        text = r.read().decode("utf-8")
    stripped = text.lstrip()
    if stripped.startswith("<!doctype") or stripped.startswith("<html"):
        return "⚠️ 保策服务暂不可用（网关返回了页面而非接口），稍后重试或发「状态」确认"
    return text


