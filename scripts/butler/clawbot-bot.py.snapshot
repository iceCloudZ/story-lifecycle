# ─── 管家(story-butler,经桌面反向隧道 → 令牌代理 → story serve)───
# 约定(DESIGN-story-butler §3.3/§3.4):token 与桌面 scripts/butler/butler.env 一致;
# 终态/发布类确认一律不在微信做(桌面代理还有 403 兜底)。
BUTLER_API = "http://127.0.0.1:18180"
BUTLER_TOKEN = "5a463f6d19a0989e215a5d8c69b4da6c6c988eaf62758eef"
ADVANCE_TTL = 300   # 「推进」确认有效期(秒),与「完成」一致


def butler_call(method, path, json_body=None, timeout=15):
    """调桌面管家代理。返回 (ok, text):ok=False = 链路不通(隧道/代理/桌面);
    HTTP 4xx/5xx 返回响应原文(403 终态拒绝/409 门未满足/428 升级门,由调用方转述)。"""
    import urllib.error
    import urllib.request
    data = json.dumps(json_body).encode("utf-8") if json_body is not None else None
    req = urllib.request.Request(BUTLER_API + path, data=data, method=method)
    req.add_header("X-Internal-Token", BUTLER_TOKEN)
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return True, r.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        try:
            return True, e.read().decode("utf-8")
        except Exception:
            return True, f"HTTP {e.code}"
    except Exception:
        return False, ""


def butler_stories():
    """管家视野的 story 列表(serve down → ConnectionError('serve:...'),
    链路不通 → ConnectionError('tunnel'))。"""
    ok, raw = butler_call("GET", "/patrol/summary")
    if not ok:
        raise ConnectionError("tunnel")
    try:
        data = json.loads(raw)
    except Exception:
        raise ConnectionError(f"serve:{raw[:80]}")
    # 代理的拒绐体(ok:false, refused:...)不是数据 —— 识别为后端不可用
    if isinstance(data, dict) and data.get("ok") is False:
        raise ConnectionError("serve_down" if data.get("refused") == "serve_unreachable"
                              else f"serve:{data.get('refused') or raw[:60]}")
    if isinstance(data, dict):
        data = data.get("stories") or data.get("data") or []
    return [s for s in data if isinstance(s, dict)]


def _adv_gate_of(story):
    """story 详情里挑确认门:'LINK'=链路不稳 / 'TERMINAL:状态'=终态 /
    dict=可推门 / None=无门。"""
    key = story.get("storyKey") or ""
    ok, raw = butler_call("GET", f"/story/{key}/brief")
    if not ok:
        return "LINK"
    try:
        detail = json.loads(raw)
    except Exception:
        return None
    if isinstance(detail, dict) and detail.get("ok") is False:
        return "SERVEDOWN" if detail.get("refused") == "serve_unreachable" else None
    gates = [g for g in (detail.get("confirmGates") or []) if isinstance(g, dict)]
    terminal = [g for g in gates if g.get("targetIsTerminal")]
    if terminal:
        return "TERMINAL:" + str(terminal[0].get("targetState") or "终态")
    # 微信只续推 story_state 门(DESIGN-story-butler §3.4:它的续推端点是
    # /lifecycle/advance);plan_confirm/stage 门各有专门端点、语义不同,不代做。
    by_kind = {g.get("kind"): g for g in gates}
    if by_kind.get("story_state"):
        return by_kind["story_state"]
    if by_kind.get("plan_confirm"):
        return "PLAN"
    if by_kind.get("stage"):
        return "STAGE"
    return None


def cmd_progress():
    """「进度」—— story 态势(经隧道拉桌面 serve)。"""
    try:
        stories = butler_stories()
    except ConnectionError as e:
        msg = str(e)
        if msg == "tunnel":
            return "管家链路不通(隧道/代理没起或桌面没开机)😵 桌面侧看 ws/butler-keepalive.log"
        if msg == "serve_down":
            return "管家后端(story serve)没启动,桌面先跑 story serve 😵"
        return f"管家后端异常 😵 {msg}"
    if not stories:
        return "当前没有 story 在管家视野里"
    lines = ["📋 story 态势:"]
    gates = 0
    for s in stories[:10]:
        mark = ""
        if s.get("awaitingConfirm"):
            mark = " ⛔停门"
            gates += 1
        lines.append(f"・{s.get('storyKey', '?')} {(s.get('title') or '')[:24]}"
                     f" [{s.get('lifecycleState') or '?'}]{mark}")
    if len(stories) > 10:
        lines.append(f"(共 {len(stories)} 个,只列前 10)")
    if gates:
        lines.append(f"⛔ {gates} 个停在确认门,发「推进 关键词」处理")
    else:
        lines.append("无停门事项,一切照常 ✅")
    return "\n".join(lines)


def do_advance(item):
    ok, raw = butler_call("POST", f"/story/{item['key']}/advance", json_body={})
    if not ok:
        return "管家链路断了,这次没推成 😵 稍后再试"
    try:
        resp = json.loads(raw)
    except Exception:
        return f"推进已发出,管家返回:{raw[:100]}"
    if isinstance(resp, dict) and resp.get("ok") is False:
        return f"没推成:{resp.get('summary') or raw[:120]}"
    state = (resp.get("lifecycle_state") or resp.get("lifecycleState")
             or resp.get("state") or "")
    if state:
        return f"✅ 已推进:{item['title'] or item['key']} → {state}(confirmed_via=wechat)"
    return f"管家返回:{raw[:150]}"


def cmd_advance(kw):
    """「推进 关键词」—— 查停门 story,回 T/编号 确认(微信不做终态)。"""
    kw = kw.strip().lower()
    if not kw:
        return "格式:推进 关键词(标题或 key 里的几个字);先发「进度」看哪些停门"
    try:
        stories = butler_stories()
    except ConnectionError as e:
        msg = str(e)
        if msg == "tunnel":
            return "管家链路不通(隧道/代理没起或桌面没开机)😵"
        if msg == "serve_down":
            return "管家后端(story serve)没启动,桌面先跑 story serve 😵"
        return f"管家后端异常 😵 {msg}"
    matches = [s for s in stories if s.get("awaitingConfirm")
               and kw in f"{s.get('storyKey', '')}{s.get('title') or ''}".lower()]
    if not matches:
        return f"没有停确认门且含「{kw}」的 story 🤔 发「进度」对一下"
    items, skipped = [], []
    for s in matches[:8]:
        gate = _adv_gate_of(s)
        if gate in ("LINK", "SERVEDOWN"):
            return "管家链路不稳或后端没起,稍后再试 😵"
        if isinstance(gate, str) and gate.startswith("TERMINAL:"):
            skipped.append(f"{s.get('storyKey')}({gate.split(':', 1)[1]}是终态,请在桌面评审窗/UI 确认)")
            continue
        if gate == "PLAN":
            skipped.append(f"{s.get('storyKey')}(停在规划确认,请在桌面评审窗/plan confirm 做,微信不代做)")
            continue
        if gate == "STAGE":
            skipped.append(f"{s.get('storyKey')}(停在 stage 门,请在桌面会话推进)")
            continue
        if gate:
            items.append({"key": s.get("storyKey"), "title": s.get("title") or "",
                          "target": gate.get("targetState") or "?"})
    if items and len(items) == 1:
        it = items[0]
        _pending_adv.clear()
        _pending_adv.update({"ts": time.time(), "items": [it]})
        return (f"{it['title'] or it['key']} 停在确认门,可推进到「{it['target']}」。\n"
                f"回 T 确认推进 / 回其他取消(5 分钟内有效)")
    if items:
        _pending_adv.clear()
        _pending_adv.update({"ts": time.time(), "items": items})
        lines = [f"找到 {len(items)} 个,回编号(或 T=第一个)选择推进:"]
        lines += [f"{i}. {it['title'] or it['key']} → {it['target']}"
                  for i, it in enumerate(items, 1)]
        lines.append("5 分钟内有效,回其他内容取消")
        if skipped:
            lines.append(";" + ";".join(skipped))
        return "\n".join(lines)
    if skipped:
        return ";\n".join(["这些 story 的门不能在微信推:"] + skipped)
    return "没找到可推的确认门,发「进度」看看"


